---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const researchPosts = await getCollection('research', ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = researchPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Research - Souzou Maker">
  <section class="page-header">
    <h1>Research</h1>
    <p>Publications in fluorescence imaging, medical device development, and computational fabrication</p>
  </section>

  <div class="research-list">
    {sortedPosts.length === 0 ? (
      <p class="empty-state">No research posts yet. Check back soon!</p>
    ) : (
      sortedPosts.map((post) => (
        <article class={`research-card ${post.data.firstAuthor ? 'first-author' : ''}`}>
          <div class="paper-header">
            {post.data.firstAuthor && (
              <span class="first-author-badge">First Author</span>
            )}
            <h2>
              <a href={`/research/${post.slug}`}>{post.data.title}</a>
            </h2>
          </div>

          {post.data.authors && post.data.authors.length > 0 && (
            <p class="authors">{post.data.authors.join(', ')}</p>
          )}

          {post.data.venue && (
            <p class="venue">
              <em>{post.data.venue}</em>
              {post.data.year && ` (${post.data.year})`}
            </p>
          )}

          {post.data.description && (
            <p class="description">{post.data.description}</p>
          )}

          <div class="meta">
            {post.data.pdfUrl && (
              <a href={post.data.pdfUrl} class="pdf-link" target="_blank" rel="noopener noreferrer">
                PDF
              </a>
            )}
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin: 3rem 0;
  }

  .page-header p {
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .research-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .empty-state {
    text-align: center;
    color: var(--color-muted);
    padding: 3rem;
  }

  .research-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    transition: all 0.2s;
  }

  .research-card:hover {
    border-color: var(--color-accent);
  }

  .research-card.first-author {
    border-left: 4px solid var(--color-accent);
    background: rgba(37, 99, 235, 0.02);
  }

  .paper-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .first-author-badge {
    background: var(--color-accent);
    color: white;
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .research-card h2 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .research-card h2 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .research-card h2 a:hover {
    color: var(--color-accent);
  }

  .authors {
    color: var(--color-text);
    margin-bottom: 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 400;
  }

  .venue {
    color: var(--color-muted);
    margin-bottom: 1rem;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .description {
    color: var(--color-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .pdf-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    transition: all 0.2s;
  }

  .pdf-link:hover {
    background: var(--color-accent);
    color: white;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
