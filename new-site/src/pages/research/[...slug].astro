---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const researchPosts = await getCollection('research');
  return researchPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, date, description, tags, authors, venue, year, pdfUrl, firstAuthor } = post.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} - Research`}>
  <article class="research-paper">
    <header>
      {firstAuthor && (
        <div class="first-author-indicator">
          <span class="badge">First Author</span>
        </div>
      )}
      <h1>{title}</h1>

      {authors && authors.length > 0 && (
        <div class="authors">
          {authors.join(', ')}
        </div>
      )}

      <div class="publication-info">
        {venue && <div class="venue"><em>{venue}</em></div>}
        {year && <div class="year">{year}</div>}
      </div>

      {pdfUrl && (
        <div class="pdf-link-container">
          <a href={pdfUrl} class="pdf-button" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8.5 6.5a.5.5 0 0 0-1 0v3.793L6.354 9.146a.5.5 0 1 0-.708.708l2 2a.5.5 0 0 0 .708 0l2-2a.5.5 0 0 0-.708-.708L8.5 10.293V6.5z"/>
              <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
            </svg>
            Download PDF
          </a>
        </div>
      )}

      {description && (
        <div class="description">
          <p>{description}</p>
        </div>
      )}

      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .research-paper {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
  }

  .first-author-indicator {
    margin-bottom: 1rem;
  }

  .badge {
    display: inline-block;
    background: var(--color-accent);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: 2rem;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .authors {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .publication-info {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .venue {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .year {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .venue::after {
    content: "•";
    margin-left: 1rem;
    color: var(--color-border);
  }

  .publication-info .year:last-child::after {
    content: none;
  }

  .pdf-link-container {
    margin: 1.5rem 0;
  }

  .pdf-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    transition: all 0.2s;
  }

  .pdf-button:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .description {
    background: var(--color-border);
    padding: 1.5rem;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .description p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.6;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .tag {
    background: var(--color-border);
    padding: 0.4rem 0.8rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .content {
    color: var(--color-text);
    line-height: 1.7;
  }

  .content :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.5rem;
    }

    .authors {
      font-size: 1rem;
    }
  }
</style>
