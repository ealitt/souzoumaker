---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const photoCollections = await getCollection('photography', ({ data }) => {
  return data.draft !== true;
});

const sortedCollections = photoCollections.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Photography - Souzou Maker">
  <section class="page-header">
    <h1>Photography</h1>
    <p>Visual explorations and captured moments</p>
  </section>

  <div class="photo-grid">
    {sortedCollections.length === 0 ? (
      <p class="empty-state">
        No photo collections yet. Coming soon!<br>
        <small>Photos will be stored cost-effectively using Cloudflare R2</small>
      </p>
    ) : (
      sortedCollections.map((collection) => (
        <article class="photo-card">
          <a href={`/photography/${collection.slug}`}>
            {collection.data.images[0] && (
              <div class="photo-preview">
                <img
                  src={collection.data.images[0].url}
                  alt={collection.data.images[0].alt || collection.data.title}
                  loading="lazy"
                />
              </div>
            )}
            <div class="photo-info">
              <h2>{collection.data.title}</h2>
              {collection.data.location && (
                <p class="location">{collection.data.location}</p>
              )}
              <time datetime={collection.data.date.toISOString()}>
                {new Date(collection.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long'
                })}
              </time>
              <p class="count">{collection.data.images.length} photos</p>
            </div>
          </a>
        </article>
      ))
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin: 3rem 0;
  }

  .page-header p {
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .empty-state {
    text-align: center;
    color: var(--color-muted);
    padding: 3rem;
    grid-column: 1 / -1;
  }

  .empty-state small {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.9em;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .photo-card {
    overflow: hidden;
    border-radius: 8px;
    transition: transform 0.2s;
  }

  .photo-card:hover {
    transform: scale(1.02);
  }

  .photo-preview {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--color-border);
  }

  .photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-info {
    padding: 1rem;
    background: var(--color-border);
  }

  .photo-info h2 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .location {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  time, .count {
    display: block;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
