---
import BaseLayout from './BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, thumbnail, galleries } = post.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} - Souzou Maker`}>
  <article class="blog-post">
    <header>
      <h1>{title}</h1>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </header>

    {thumbnail && (
      <div class="hero-image">
        <img
          src={thumbnail.url}
          alt={title}
          width={thumbnail.dimensions?.[0] || 1920}
          height={thumbnail.dimensions?.[1] || 1080}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <!-- Image galleries from migrated data -->
    {galleries && Object.entries(galleries).map(([category, images]) => (
      <section class="gallery-section">
        <h2>{category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}</h2>
        <Lightbox images={images} />
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .blog-post header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-post h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  time {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .hero-image {
    margin: 2rem 0 3rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    max-height: 50vh;
    object-fit: contain;
    display: block;
  }

  .prose {
    max-width: 70ch;
    margin: 0 auto;
    background: transparent;
  }

  /* Override any default Astro/Shiki code block styles */
  .prose :global(pre) {
    background: var(--color-border) !important;
  }

  .prose :global(pre code) {
    background: transparent !important;
  }

  .gallery-section {
    margin: 4rem 0;
  }

  .gallery-section h2 {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-accent);
  }

  @media (max-width: 768px) {
    .blog-post h1 {
      font-size: 1.75rem;
    }

    .hero-image {
      margin: 1.5rem 0 2rem;
    }
  }
</style>
