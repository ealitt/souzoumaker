---
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.language === 'english';
});

// Sort by date, newest first
const posts = allBlogPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<div class="project-grid">
  {posts.map((post) => (
    <a href={`/blog/${post.slug}`} class="project-card">
      {post.data.thumbnail && (
        <img
          src={post.data.thumbnail.url}
          alt={post.data.title}
          loading="lazy"
        />
      )}
      <div class="overlay">
        <div class="overlay-content">
          <h3>{post.data.title}</h3>
          <div class="meta">
            <time datetime={post.data.date.toISOString()}>
              {new Date(post.data.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              })}
            </time>
            {post.data.categories && post.data.categories.length > 0 && (
              <div class="categories">
                {post.data.categories.map(cat => (
                  <span class="category-tag">{cat}</span>
                ))}
              </div>
            )}
          </div>
        </div>
        <div class="hover-details">
          <p class="preview-text">Click to view project</p>
        </div>
      </div>
    </a>
  ))}
</div>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 3/2;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .project-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .project-card:hover img {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
    padding: 1.5rem;
    color: white;
    transition: background 0.3s ease;
  }

  .project-card:hover .overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 70%, transparent 100%);
  }

  .overlay-content {
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  time {
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .categories {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .category-tag {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    backdrop-filter: blur(4px);
  }

  .hover-details {
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .project-card:hover .hover-details {
    opacity: 1;
    transform: translateY(0);
  }

  .preview-text {
    font-size: 0.9rem;
    opacity: 0.9;
    margin: 0;
  }

  @media (max-width: 768px) {
    .project-card {
      aspect-ratio: 4/3;
    }

    h3 {
      font-size: 1rem;
    }

    .hover-details {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
